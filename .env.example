# Copy this file to `.env` and fill in the value - copy, don't rename, so the
# template stays behind for the next person:
#
#     copy .env.example .env          (Windows)
#     cp   .env.example .env          (bash)
#
# `.env` is gitignored and never committed. Anything already exported in the
# real environment wins over it, so CI and scheduled runs can supply the key
# their own way without editing anything here.

# The RBHQ feed API key, sent as `Authorization: Bearer <key>` by default.
# Change auth_header / auth_prefix / auth_param in config.yaml if the API
# expects it some other way.
RBHQ_API_KEY=

# Optional: override the User-Agent harness_scraper sends (nothing secret here).
# HARNESS_USER_AGENT=
